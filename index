      b.addEventListener('click', () => set(k, ''));
      chips.appendChild(b);
    }
  }
  function set(k, v) { F[k] = v; writeHash(); render(); }
  const toggle = (k, v) => set(k, F[k] === v ? '' : v);
  $('f-ppd').addEventListener('change', (e) => set('ppd', e.target.value));
  $('f-nazir').addEventListener('change', (e) => set('nazir', e.target.value));
  $('f-jenis').addEventListener('change', (e) => set('jenis', e.target.value));
  $('f-bulan').addEventListener('change', (e) => set('bulan', e.target.value));
