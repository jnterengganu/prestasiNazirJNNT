    const max = Math.max(...data.map((d) => d.n)) || 1;
    const step = Math.pow(10, Math.floor(Math.log10(max)));
    const tickStep = [1, 2, 5, 10].map((s) => s * step).find((s) => max / s <= 4) || step * 10;
    const top = Math.ceil(max / tickStep) * tickStep;
    const y = (v) => H - m.b - v / top * (H - m.t - m.b);
    const band = (W - m.l - m.r) / data.length, bw = band * 0.68;
    const svg = el('svg:svg', {viewBox: `0 0 ${W} ${H}`, height: H, role: 'img', 'aria-label': 'Carta bar bilangan pemeriksaan setiap bulan'});
    for (let v = 0; v <= top; v += tickStep) {
      svg.append(el('svg:line', {class: 'gridline', x1: m.l, x2: W - m.r, y1: y(v), y2: y(v)}),
        el('svg:text', {class: 'axis', x: m.l - 6, y: y(v), dy: '0.32em', 'text-anchor': 'end'}, fmt(v)));
    }
    const tip = makeTip(box);
    const narrow = bw < 22;
    data.forEach((d, i) => {
      const x = m.l + i * band + (band - bw) / 2;
      const on = !F.bulan || F.bulan === d.k;
      const r = el('svg:rect', {class: 'bar', x, width: bw, rx: 3, y: y(d.n), height: Math.max(0, y(0) - y(d.n))});
      r.style.fill = on ? 'var(--accent)' : 'var(--mute-bar)';
      svg.appendChild(r);
      if (!(narrow && d.n === 0)) svg.appendChild(el('svg:text', {class: 'val', x: x + bw / 2, y: y(d.n) - 5, 'text-anchor': 'middle'}, fmt(d.n)));
      if (!(narrow && i % 2)) svg.appendChild(el('svg:text', {class: 'axis', x: x + bw / 2, y: H - 8, 'text-anchor': 'middle'}, BULAN[+d.k.slice(5, 7) - 1]));
      const hit = el('svg:rect', {class: 'hit', x: m.l + i * band, width: band, y: m.t, height: H - m.t - m.b, fill: 'transparent'});
      hit.addEventListener('mousemove', (e) => tip.show(e, bulanP(d.k), [fmt(d.n) + ' pemeriksaan']));
      hit.addEventListener('mouseleave', () => tip.hide());
      hit.addEventListener('click', () => { if (d.n || F.bulan === d.k) toggle('bulan', d.k); });
      svg.appendChild(hit);
    });
    box.prepend(svg);
  }

  function renderPpd() {
    const rows = filtered('ppd');
    const data = countBy(rows, (r) => r.ppd).sort((a, b) => b.n - a.n);
    const sek = new Map(), tug = new Map();
    for (const r of rows) { if (!sek.has(r.ppd)) sek.set(r.ppd, new Set()); sek.get(r.ppd).add(r.kod_sekolah); tug.set(r.ppd, (tug.get(r.ppd) || 0) + 1); }
    hbar($('c-ppd'), data, {
      label: (d) => d.k, aria: 'Carta bar pemeriksaan bagi setiap PPD',
      active: (d) => !F.ppd || F.ppd === d.k,
      tip: (d) => [fmt(d.n) + ' pemeriksaan', fmt(sek.get(d.k).size) + ' sekolah', fmt(tug.get(d.k)) + ' penugasan nazir'],
      onClick: (d) => toggle('ppd', d.k)
    });
  }
  function renderJenis() {
    const rows = filtered('jenis');
    const data = countBy(rows, (r) => r.jenis_pemeriksaan).sort((a, b) => b.n - a.n);
    const tot = data.reduce((s, d) => s + d.n, 0);
    hbar($('c-jenis'), data, {
      label: (d) => d.k, aria: 'Carta bar pemeriksaan mengikut jenis pemeriksaan',
      active: (d) => !F.jenis || F.jenis === d.k,
      tip: (d) => [fmt(d.n) + ' pemeriksaan', Math.round(d.n / tot * 100) + '% daripada jumlah'],
      onClick: (d) => toggle('jenis', d.k)
    });
  }
  function renderJsek(rows) {
    const data = countBy(rows, (r) => r.jenis_sekolah).sort((a, b) => b.n - a.n);
    const tot = data.reduce((s, d) => s + d.n, 0);
    hbar($('c-jsek'), data, {label: (d) => d.k, aria: 'Carta bar pemeriksaan mengikut jenis sekolah', tip: (d) => [fmt(d.n) + ' pemeriksaan', Math.round(d.n / tot * 100) + '% daripada jumlah']});
  }
  function renderLokasi(rows) {
    const box = $('c-lokasi'); box.replaceChildren();
    const order = ['Bandar', 'Luar Bandar'];
    const data = countBy(rows, (r) => r.lokasi).sort((a, b) => order.indexOf(a.k) - order.indexOf(b.k));
    if (!data.length) { msg(box, 'Tiada rekod bagi pilihan ini.'); return; }
    const tot = data.reduce((s, d) => s + d.n, 0);
    const cols = ['var(--accent)', 'var(--accent-2)'];
    const track = el('div', {class: 'split-track', role: 'img'});
    const legend = el('div', {class: 'split-legend'});
    const tip = makeTip(box);
    const parts = [];
    data.forEach((d, i) => {
      const pc = Math.round(d.n / tot * 1000) / 10;
      parts.push(d.k + ' ' + pc + ' peratus');
      const seg = el('div'); seg.style.width = pc + '%'; seg.style.background = cols[i % 2];
      seg.addEventListener('mousemove', (e) => tip.show(e, d.k, [fmt(d.n) + ' pemeriksaan', pc + '%']));
      seg.addEventListener('mouseleave', () => tip.hide());
      track.appendChild(seg);
      const it = el('span'); const sw = el('i'); sw.style.background = cols[i % 2];
      it.append(sw, d.k + ' · ', el('b', null, fmt(d.n)), ' (' + pc + '%)');
      legend.appendChild(it);
    });
    track.setAttribute('aria-label', parts.join(', '));
    box.prepend(track, legend);
  }

  function renderNazir(rowsAll) {
    // Ignore nazir filter so all officers remain visible and the chosen one is highlighted
    const rows = filtered('nazir');
    const g = new Map();
    for (const r of rows) {
      if (!g.has(r.nazir)) g.set(r.nazir, {nazir: r.nazir, pejabat: r.pejabat, tug: 0, sek: new Set(), prog: new Set(), guru: 0, last: ''});
      const o = g.get(r.nazir); o.tug++; o.sek.add(r.kod_sekolah); o.prog.add(r.nama_pemeriksaan); o.guru += r.guru; if (r.tarikh_mula > o.last) o.last = r.tarikh_mula;
    }
    const q = $('cari-nazir').value.trim().toLowerCase();
    const list = [...g.values()].filter((o) => !q || o.nazir.toLowerCase().includes(q)).sort((a, b) => b.tug - a.tug || b.guru - a.guru || a.nazir.localeCompare(b.nazir));
    const tb = $('t-nazir'); tb.replaceChildren();
    if (!list.length) { const tr = tb.insertRow(); const td = tr.insertCell(); td.colSpan = 7; td.className = 'sub'; td.textContent = 'Tiada pegawai sepadan.'; return; }
    for (const o of list) {
      const tr = tb.insertRow(); tr.className = 'click' + (F.nazir === o.nazir ? ' on' : ''); tr.tabIndex = 0;
      tr.setAttribute('aria-label', 'Tapis ikut ' + titleCase(o.nazir));
      const cells = [[titleCase(o.nazir)], [titleCase(o.pejabat), 'sub'], [fmt(o.tug), 'n'], [fmt(o.sek.size), 'n'], [fmt(o.prog.size), 'n'], [fmt(o.guru), 'n'], [tarikhPendek(o.last), 'date sub']];
      for (const [t, c] of cells) { const td = tr.insertCell(); td.textContent = t; if (c) td.className = c; }
      const go = () => toggle('nazir', o.nazir);
      tr.addEventListener('click', go);
      tr.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    }
  }

  function renderProgram(rows) {
    const g = new Map();
    for (const r of rows) {
      if (!g.has(r.nama_pemeriksaan)) g.set(r.nama_pemeriksaan, {p: r.nama_pemeriksaan, j: r.jenis_pemeriksaan, k: new Set(), s: new Set(), guru: 0});
      const o = g.get(r.nama_pemeriksaan); o.k.add(r.key); o.s.add(r.kod_sekolah); o.guru += r.guru;
    }
    const list = [...g.values()].sort((a, b) => b.k.size - a.k.size);
    const tb = $('t-program'); tb.replaceChildren();
    if (!list.length) { const tr = tb.insertRow(); const td = tr.insertCell(); td.colSpan = 5; td.className = 'sub'; td.textContent = 'Tiada rekod bagi pilihan ini.'; return; }
    for (const o of list) {
      const tr = tb.insertRow();
      for (const [t, c] of [[o.p], [o.j, 'sub'], [fmt(o.k.size), 'n'], [fmt(o.s.size), 'n'], [fmt(o.guru), 'n']]) { const td = tr.insertCell(); td.textContent = t; if (c) td.className = c; }
    }
  }

  function renderSenarai(rows) {
    // One line per inspection, listing every officer on it (from the unfiltered set)
    const keys = new Set(rows.map((r) => r.key));
    const g = new Map();
    for (const r of ALL) {
      if (!keys.has(r.key)) continue;
      if (!g.has(r.key)) g.set(r.key, {r, naz: new Set(), guru: 0});
      const o = g.get(r.key); o.naz.add(r.nazir); o.guru += r.guru;
    }
    const q = $('cari-sekolah').value.trim().toLowerCase();
    const list = [...g.values()].filter((o) => !q || o.r.nama_sekolah.toLowerCase().includes(q) || o.r.kod_sekolah.toLowerCase().includes(q))
      .sort((a, b) => b.r.tarikh_mula.localeCompare(a.r.tarikh_mula) || a.r.nama_sekolah.localeCompare(b.r.nama_sekolah));
    $('senarai-count').textContent = fmt(list.length) + ' pemeriksaan, terkini di atas.';
    const tb = $('t-senarai'); tb.replaceChildren();
    if (!list.length) { const tr = tb.insertRow(); const td = tr.insertCell(); td.colSpan = 6; td.className = 'sub'; td.textContent = 'Tiada pemeriksaan sepadan.'; return; }
    for (const o of list) {
      const r = o.r, tr = tb.insertRow();
      const dt = r.tarikh_mula === r.tarikh_tamat ? tarikhPendek(r.tarikh_mula) : tarikhPendek(r.tarikh_mula) + ' – ' + tarikhPendek(r.tarikh_tamat);
      const sek = tr.insertCell(); sek.append(el('div', null, titleCase(r.nama_sekolah)), el('div', {class: 'count'}, r.kod_sekolah + ' · ' + r.jenis_sekolah));
      const cells = [[dt, 'date']];
      const td0 = tr.insertCell(0); td0.textContent = cells[0][0]; td0.className = 'date';
      const tdP = tr.insertCell(); tdP.textContent = r.ppd; tdP.className = 'sub';
      const tdG = tr.insertCell(); tdG.textContent = r.nama_pemeriksaan;
      const tdN = tr.insertCell(); tdN.className = 'sub'; tdN.textContent = [...o.naz].map(titleCase).join(', ');
      const tdC = tr.insertCell(); tdC.className = 'n'; tdC.textContent = fmt(o.guru);
    }
  }

  function render() {
    const rows = filtered();
    renderFilters();
    renderLede(rows);
    renderKpi(rows);
    renderBulan();
    renderPpd();
    renderJenis();
    renderJsek(rows);
    renderLokasi(rows);
    renderNazir(rows);
    renderProgram(rows);
    renderSenarai(rows);
  }

  readHash();
  render();
  let rt;
  const ro = new ResizeObserver(() => { clearTimeout(rt); rt = setTimeout(() => { const rows = filtered(); renderBulan(); renderPpd(); renderJenis(); renderJsek(rows); }, 120); });
  ro.observe(document.querySelector('main'));
  window.addEventListener('hashchange', () => { for (const k in F) F[k] = ''; readHash(); render(); });
})();
</script>
</body>
</html>
