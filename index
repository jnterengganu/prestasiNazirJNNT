<script>
(() => {
  'use strict';
  // ---------- Data ----------
  const RAW = JSON.parse(document.getElementById('data').textContent);
  const C = RAW.cols, D = RAW.dicts;
  const ALL = RAW.rows.map((r) => {
    const o = {};
    C.forEach((c, i) => { o[c] = D[c] ? D[c][r[i]] : r[i]; });
    o.ppd = o.ppd || '';
    o.key = o.kod_sekolah + '|' + o.nama_pemeriksaan + '|' + o.tarikh_mula;
    o.bulan = o.tarikh_mula.slice(0, 7);
    o.guru = Number(o.guru_dicerap) || 0;
    return o;
  });

  const BULAN = ['Jan', 'Feb', 'Mac', 'Apr', 'Mei', 'Jun', 'Jul', 'Ogo', 'Sep', 'Okt', 'Nov', 'Dis'];
  const BULAN_P = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];
  const nf = new Intl.NumberFormat('ms-MY');
  const fmt = (n) => nf.format(n);
  const tarikh = (iso) => { const [y, m, d] = iso.split('-'); return (+d) + ' ' + BULAN_P[+m - 1] + ' ' + y; };
  const tarikhPendek = (iso) => { const [y, m, d] = iso.split('-'); return (+d) + ' ' + BULAN[+m - 1] + ' ' + y; };
  const bulanP = (ym) => BULAN_P[+ym.slice(5, 7) - 1] + ' ' + ym.slice(0, 4);
  const titleCase = (s) => s.toLowerCase().replace(/(^|[\s(@./-])([a-z])/g, (m, a, b) => a + b.toUpperCase());
  const uniq = (arr) => [...new Set(arr)];

  // Full month range in the data
  const monthsAll = (() => {
    const m = ALL.map((r) => r.bulan).sort();
    const out = []; let [y, mo] = m[0].split('-').map(Number); const [ey, em] = m[m.length - 1].split('-').map(Number);
    while (y < ey || (y === ey && mo <= em)) { out.push(y + '-' + String(mo).padStart(2, '0')); mo++; if (mo > 12) { mo = 1; y++; } }
    return out;
  })();
  const period = (() => { const t = ALL.map((r) => r.tarikh_mula).sort(); return [t[0], t[t.length - 1]]; })();

  // ---------- State ----------
  const F = {ppd: '', nazir: '', jenis: '', bulan: ''};
  const LABEL = {ppd: 'PPD', nazir: 'Pegawai', jenis: 'Jenis', bulan: 'Bulan'};
  const show = {ppd: (v) => 'PPD ' + v, nazir: (v) => titleCase(v), jenis: (v) => v, bulan: (v) => bulanP(v)};
  function readHash() {
    try {
      const h = decodeURIComponent(location.hash.slice(1));
      if (!h) return;
      for (const part of h.split('&')) { const [k, v] = part.split('='); if (k in F && v) F[k] = v; }
    } catch (e) { /* ignore */ }
  }
  function writeHash() {
    const parts = Object.entries(F).filter(([, v]) => v).map(([k, v]) => k + '=' + v);
    const h = parts.length ? '#' + encodeURIComponent(parts.join('&')) : '';
    try { history.replaceState(null, '', location.pathname + location.search + h); } catch (e) { /* ignore */ }
  }
  const match = (r, skip) => (skip === 'ppd' || !F.ppd || r.ppd === F.ppd)
    && (skip === 'nazir' || !F.nazir || r.nazir === F.nazir)
    && (skip === 'jenis' || !F.jenis || r.jenis_pemeriksaan === F.jenis)
    && (skip === 'bulan' || !F.bulan || r.bulan === F.bulan);
  const filtered = (skip) => ALL.filter((r) => match(r, skip));

  // count unique inspections by a dimension
  function countBy(rows, fn) {
    const m = new Map();
    for (const r of rows) { const k = fn(r); if (!m.has(k)) m.set(k, new Set()); m.get(k).add(r.key); }
    return [...m].map(([k, s]) => ({k, n: s.size}));
  }

  // ---------- Helpers ----------
