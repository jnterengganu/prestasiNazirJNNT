        tip.style.left = Math.max(0, Math.min(box.clientWidth - tip.offsetWidth, px + 12)) + 'px';
        tip.style.top = Math.max(0, py - tip.offsetHeight - 10) + 'px';
      },
      hide() { tip.hidden = true; }
    };
  }
  let measurer;
  function textW(str, cls) {
