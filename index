  $('cari-nazir').addEventListener('input', () => renderNazir(filtered()));
  $('cari-sekolah').addEventListener('input', () => renderSenarai(filtered()));

  // ---------- Sections ----------
  function renderKpi(rows) {
    const keys = uniq(rows.map((r) => r.key));
    $('k-pem').textContent = fmt(keys.length);
    $('k-sek').textContent = fmt(uniq(rows.map((r) => r.kod_sekolah)).length);
    $('k-tug').textContent = fmt(rows.length);
    $('k-naz').textContent = fmt(uniq(rows.map((r) => r.nazir)).length);
    $('k-gur').textContent = fmt(rows.reduce((s, r) => s + r.guru, 0));
  }

  function renderLede(rows) {
    const lede = $('lede'); lede.replaceChildren();
    const b = (t) => el('b', null, t);
    if (!rows.length) { lede.textContent = 'Tiada pemeriksaan sepadan dengan penapis yang dipilih.'; return; }
    const keys = uniq(rows.map((r) => r.key)).length;
    const sek = uniq(rows.map((r) => r.kod_sekolah)).length;
    const who = F.nazir ? titleCase(F.nazir) : (F.ppd ? 'PPD ' + F.ppd : 'Jemaah Nazir Negeri Terengganu');
    const t = rows.map((r) => r.tarikh_mula).sort();
    const months = countBy(rows, (r) => r.bulan).sort((a, b2) => b2.n - a.n);
    const jen = countBy(rows, (r) => r.jenis_pemeriksaan).sort((a, b2) => b2.n - a.n);
    lede.append(b(who), F.nazir ? ' terlibat dalam ' : ' merekodkan ', b(fmt(keys)), ' pemeriksaan di ', b(fmt(sek)), ' sekolah antara ',
      b(tarikh(t[0])), ' dan ', b(tarikh(t[t.length - 1])), '. ');
    if (!F.bulan) lede.append('Bulan paling sibuk ialah ', b(bulanP(months[0].k)), ' dengan ', b(fmt(months[0].n)), ' pemeriksaan');
    if (!F.jenis) lede.append(F.bulan ? 'Jenis paling kerap ialah ' : ', dan jenis paling kerap ialah ', b(jen[0].k.toLowerCase()), '.');
