    measurer.setAttribute('class', cls); measurer.textContent = str;
    return measurer.getComputedTextLength() || str.length * 6.5;
  }
  function truncate(str, max, cls) {
    if (textW(str, cls) <= max) return str;
    let t = str;
    while (t.length > 3 && textW(t + '…', cls) > max) t = t.slice(0, -1);
    return t.trimEnd() + '…';
  }

  // Horizontal bar chart
  function hbar(box, data, o) {
    box.replaceChildren();
    if (!data.length) { msg(box, 'Tiada rekod bagi pilihan ini.'); return; }
    const W = Math.max(260, box.clientWidth || 400), rowH = 30, barH = 18;
    const lw = Math.max(...data.map((d) => textW(o.label(d), 'lbl')));
    const vw = Math.max(...data.map((d) => textW(fmt(d.n), 'val')));
    const maxL = Math.min(lw, W * 0.42), left = maxL + 10;
    const H = data.length * rowH;
    const max = Math.max(...data.map((d) => d.n)) || 1;
    const span = Math.max(40, W - left - vw - 10);
    const svg = el('svg:svg', {viewBox: `0 0 ${W} ${H}`, height: H, role: 'img', 'aria-label': o.aria});
    const tip = makeTip(box);
    data.forEach((d, i) => {
      const g = el('svg:g', {class: 'row', transform: `translate(0,${i * rowH})`});
      const bw = Math.max(2, d.n / max * span);
      const lab = el('svg:text', {class: 'lbl', x: left - 10, y: rowH / 2, dy: '0.35em', 'text-anchor': 'end'}, truncate(o.label(d), maxL, 'lbl'));
      const bar = el('svg:rect', {class: 'bar', x: left, y: (rowH - barH) / 2, height: barH, width: bw, rx: 3});
      bar.style.fill = o.active && o.active(d) === false ? 'var(--mute-bar)' : 'var(--accent)';
      const val = el('svg:text', {class: 'val', x: left + bw + 6, y: rowH / 2, dy: '0.35em'}, fmt(d.n));
      const hit = el('svg:rect', {class: o.onClick ? 'hit' : '', width: W, height: rowH, fill: 'transparent'});
      hit.addEventListener('mousemove', (e) => tip.show(e, o.label(d), o.tip(d)));
      hit.addEventListener('mouseleave', () => tip.hide());
      hit.addEventListener('click', (e) => { tip.show(e, o.label(d), o.tip(d)); if (o.onClick) o.onClick(d); });
      g.append(lab, bar, val, hit);
      svg.appendChild(g);
    });
    box.prepend(svg);
  }

  // ---------- Filters UI ----------
  function fillSelect(sel, allLabel, values, labelFn, current) {
    sel.replaceChildren(new Option(allLabel, ''), ...values.map((v) => new Option(labelFn(v), v)));
    sel.value = values.includes(current) ? current : '';
  }
  function renderFilters() {
    // Each list shows values available under the other filters, plus the current pick
    const ppds = uniq(filtered('ppd').map((r) => r.ppd).concat(F.ppd ? [F.ppd] : [])).filter(Boolean).sort();
    fillSelect($('f-ppd'), 'Semua PPD', ppds, (v) => 'PPD ' + v, F.ppd);
    const naz = uniq(filtered('nazir').map((r) => r.nazir).concat(F.nazir ? [F.nazir] : [])).sort((a, b) => a.localeCompare(b));
    fillSelect($('f-nazir'), 'Semua pegawai (' + naz.length + ')', naz, titleCase, F.nazir);
    const jen = uniq(filtered('jenis').map((r) => r.jenis_pemeriksaan).concat(F.jenis ? [F.jenis] : [])).sort();
    fillSelect($('f-jenis'), 'Semua jenis', jen, (v) => v, F.jenis);
    const bl = uniq(filtered('bulan').map((r) => r.bulan).concat(F.bulan ? [F.bulan] : [])).sort();
    fillSelect($('f-bulan'), 'Semua bulan', bl, bulanP, F.bulan);
    const chips = $('chips'); chips.replaceChildren();
    for (const [k, v] of Object.entries(F)) {
