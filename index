.sec h2 { margin: 0; font-size: 17px; font-weight: 600; text-wrap: balance; }
.sec > p { margin: 0; font-size: 13px; color: var(--muted); max-width: 72ch; }
.chart { position: relative; min-height: 120px; min-width: 0; }
.chart svg { display: block; width: 100%; overflow: visible; }
.chart text { font-family: var(--sans); }
.lbl { font-size: 12px; fill: var(--fg); }
.val { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
.axis { font-size: 11px; fill: var(--muted); }
.gridline { stroke: var(--line); }
.hit { cursor: pointer; }
.row:hover .bar { opacity: .82; }
.tip { position: absolute; z-index: 5; pointer-events: none; background: var(--tip-bg); border: 1px solid var(--line); box-shadow: var(--shadow); border-radius: 8px; padding: 8px 10px; font-size: 12px; line-height: 1.45; max-width: 260px; }
.tip strong { display: block; font-weight: 600; margin-bottom: 2px; }
.tip span { display: block; color: var(--muted); font-variant-numeric: tabular-nums; }
.empty { font-size: 13px; color: var(--muted); padding: 12px 0; }
.split-track { display: flex; height: 22px; border-radius: 6px; overflow: hidden; background: var(--line); }
.split-legend { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 13px; margin-top: 10px; }
.split-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
.split-legend b { font-variant-numeric: tabular-nums; font-weight: 600; }
