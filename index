.tile h3 { margin: 0; font-size: 12px; font-weight: 500; color: var(--muted); }
.tile .num { font-family: var(--serif); font-size: 2.1rem; line-height: 1.15; font-variant-numeric: tabular-nums; }
.tile p { margin: 0; font-size: 12px; color: var(--muted); }
